{
  "name": "mtgcalc-web",
  "private": true,
  "version": "0.1.0",
  "description": "The mtgcalc web app: exact draw odds for Magic: The Gathering, computed in the browser by the Rust core (ADR-0013).",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.11.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "scripts": {
    "wasm": "node scripts/build-wasm.mjs",
    "dev": "vite",
    "build": "npm run wasm && tsc -p . && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p .",
    "lint": "eslint . && prettier --check .",
    "e2e": "playwright test"
  }
}
